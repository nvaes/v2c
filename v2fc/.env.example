# Copier en .env puis compléter avant `docker compose up`.
# .env ne doit jamais être commité (secrets réels).

# --- Secrets obligatoires, pas de valeur par défaut (api/config.py) -------

# Clé de signature des jetons JWT. Générer par ex. :
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# Clé de chiffrement enveloppe (KEK) des identifiants stockés en base
# (ARCHITECTURE.md §13) — 32 octets encodés en base64. Générer avec :
#   python3 -c "import os,base64; print(base64.b64encode(os.urandom(32)).decode())"
V2FC_KEK=

# Secret partagé entre l'API et le service runner (exécution automatique des
# rounds de migration). Générer par ex. :
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
V2FC_RUNNER_TOKEN=

# --- Postgres (utilisé par le service postgres ET par DATABASE_URL construit
#     dans docker-compose.yml — ne pas fixer DATABASE_URL vous-même ici,
#     il est dérivé de ces trois variables pour rester cohérent) -----------
POSTGRES_USER=v2fc
POSTGRES_PASSWORD=v2fc
POSTGRES_DB=v2fc

# --- Divers ----------------------------------------------------------------

# Origines autorisées en CORS côté API (liste séparée par des virgules).
# http://localhost:5173 correspond au serveur de dev Vite du service web.
CORS_ORIGINS=http://localhost:5173

# Adresse d'écoute de l'interface web (port 5173). 127.0.0.1 = ce poste
# uniquement ; 0.0.0.0 = accessible depuis le réseau (VM de déploiement,
# avec CORS_ORIGINS=http://<ip-ou-nom-de-la-vm>:5173).
V2FC_WEB_BIND=127.0.0.1
